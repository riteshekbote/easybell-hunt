def get(url):
    req = urllib.request.Request(url, method='GET', headers={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/126 Safari/537.36','Accept':'text/html,*/*'})
    try:
        r = urllib.request.urlopen(req, timeout=20)
        b = r.read(220)
        return r.status, r.geturl(), dict(r.headers), b
    except urllib.error.HTTPError as e:
        return e.code, e.geturl(), dict(e.headers), e.read(220)
    except Exception as e:
        return 'ERR', '', {}, str(e).encode()
for h in hosts:
    for scheme in ('https','http'):
        st, final, hdrs, body = get(f'{scheme}://{h}/')
        ct = hdrs.get('Content-Type','')
        ser = hdrs.get('Server','')
        loc = hdrs.get('Location','')
        title = ''
        if b'<title' in body.lower():
            import re
            m = re.search(br'<title[^>]*>(.*?)</title>', body, re.I|re.S)
            if m: title = m.group(1).decode('utf-8','replace')[:60]
        tag = f"{scheme}" if (scheme=='https' and st!='ERR') else f"{scheme}[{st}]"
        rec = f"{st}\t{ct and ct.split(';')[0]}\t{ser}\t{loc[:70]}\t{title}\t{final[:60]}"
        print(f"{h}\t{tag}\t{rec}")
        if st != 'ERR' or scheme=='http' and st=='ERR':
            break
    time.sleep(1.8)
EOF
